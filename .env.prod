# Production Environment Variables
# Copy this to .env and fill in your values

# Database Configuration
POSTGRES_USER=shortchain_prod
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=shortchain_prod
DATABASE_URL=postgresql://shortchain_prod:change_this_strong_password@db:5432/shortchain_prod

# Redis Configuration
REDIS_PASSWORD=change_this_redis_password
REDIS_URL=redis://:change_this_redis_password@redis:6379/0

# Security
JWT_SECRET_KEY=1H4k4-sw0jpaEmCUpmEbm-Q2bHdxfLLrZ1kmZOhN-dk
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Settings
ENV=production
LOG_LEVEL=WARNING
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# GPU Support (set to true if you have NVIDIA GPU)
USE_GPU=false

# Optional: External Services
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
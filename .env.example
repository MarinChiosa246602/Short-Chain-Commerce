# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/shortchain

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration
YOLO_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.7
DETECTION_CONFIDENCE=0.5

# OCR Configuration
OCR_LANGUAGE=en
OCR_USE_GPU=false

# Monitoring
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# GPU Configuration (set to true if NVIDIA GPU available)
USE_GPU=false
